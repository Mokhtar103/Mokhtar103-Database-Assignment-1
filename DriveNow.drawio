      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="MhY1mLWw5RPNvB21yXxW-1" parent="1" style="text;whiteSpace=wrap;" value="7.3&#xa;added code to Vechile_Category entity&#xa;added code to Car_Model entity&#xa;added id to category_rate entity&#xa;added id to Vehicle_Status entity&#xa;added id to _vehicle_rate entity&#xa;A vehicle-specific rate applies to an individual physical vehicle rather than all vehicles of the same model&#xa;&#xa;" vertex="1">
          <mxGeometry height="50" width="560" x="50" y="70" as="geometry" />
        </mxCell>
        <mxCell id="KNEuFOQj-8ViF7NdP23g-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="7.4&lt;br&gt;Rental has Id" vertex="1">
          <mxGeometry height="30" width="120" x="87.5" y="200" as="geometry" />
        </mxCell>
        <mxCell id="m8sO0EYzdrRZsevUIbrz-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="7.6&lt;br&gt;&lt;code&gt;VEHICLE_TRANSFER&lt;/code&gt; has its own &lt;code&gt;ID&lt;/code&gt;" vertex="1">
          <mxGeometry height="30" width="210" x="50" y="250" as="geometry" />
        </mxCell>
        <mxCell id="m8sO0EYzdrRZsevUIbrz-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span&gt;The &lt;/span&gt;&lt;span&gt;source &lt;/span&gt;&lt;span&gt;branch &lt;/span&gt;&lt;span&gt;and &lt;/span&gt;&lt;span&gt;destination &lt;/span&gt;&lt;span&gt;branch &lt;/span&gt;&lt;span&gt;must &lt;/span&gt;&lt;span&gt;be &lt;/span&gt;&lt;span&gt;different.&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="350" x="60" y="280" as="geometry" />
        </mxCell>
        <mxCell id="m8sO0EYzdrRZsevUIbrz-3" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span&gt;Each &lt;/span&gt;&lt;span&gt;transfer &lt;/span&gt;&lt;span&gt;record &lt;/span&gt;&lt;span&gt;represents &lt;/span&gt;&lt;span&gt;one &lt;/span&gt;&lt;span&gt;completed &lt;/span&gt;&lt;span&gt;physical &lt;/span&gt;&lt;span&gt;move, &lt;/span&gt;&lt;span&gt;rather &lt;/span&gt;&lt;span&gt;than &lt;/span&gt;&lt;span&gt;a &lt;/span&gt;&lt;span&gt;planned &lt;/span&gt;&lt;span&gt;or &lt;/span&gt;&lt;span&gt;cancelled &lt;/span&gt;&lt;span&gt;transfer&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="560" x="60" y="320" as="geometry" />
        </mxCell>
        <mxCell id="82aLdutVZpGiwmXmK8uY-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="7.7&lt;br&gt;&lt;code&gt;BLACKLIST_RECORD&lt;/code&gt; has its own &lt;code&gt;ID&lt;/code&gt;&lt;div&gt;&lt;code&gt;The employee who makes a blacklist decision is identified through the existing &lt;code&gt;EMPLOYEE&lt;/code&gt; entity not a branch manager sub type&lt;br&gt;Blacklist history: Multiple blacklist records can exist for the same customer, allowing the system to retain repeated decisions. Whether repeated blacklisting is permitted is not specified&lt;/code&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="640" x="-90" y="400" as="geometry" />
        </mxCell>
        <mxCell id="jGXa4eQhZIOoDQsxbu5E-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="7.8&lt;div&gt;&lt;code&gt;CORPORATE_CONTRACT&lt;/code&gt; has its own &lt;code&gt;ID&lt;/code&gt; primary key&lt;br&gt;&lt;li&gt;&lt;p&gt;Multiple contracts: A corporate customer can have multiple contracts over time.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Multiple discounts: A contract can contain multiple category discounts.&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="1090" x="-320" y="550" as="geometry" />
        </mxCell>
        <mxCell id="Kj8enoRj3DaBJhs_i9LD-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="7.10&lt;br&gt;Transaction ID: &lt;code&gt;LOYALTY_TRANSACTION&lt;/code&gt; has its own &lt;code&gt;ID&lt;/code&gt; primary key&lt;br&gt;Derived balance: The customer&#39;s balance is calculated from all earned and redeemed transactions, rather than stored as an independent value.&lt;br&gt;Derived tier: The tier is calculated from the current points balance." vertex="1">
          <mxGeometry height="30" width="700" x="-130" y="660" as="geometry" />
        </mxCell>
        <mxCell id="B64ssxxG_s288tcD2AJ_-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="7.12" vertex="1">
